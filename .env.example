# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง .env.local อยู่ใน .gitignore
# ห้าม commit ค่าจริง และห้ามวางค่าเหล่านี้ลงในแชตหรือ issue

# ฐานข้อมูล Postgres เช่นจาก Neon หรือ Supabase (บังคับ)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ในเครื่องใช้ฐาน dev เท่านั้น ห้ามใส่ production ลง TEST_DATABASE_URL
# ฐาน test ต้องแยก endpoint/database จาก dev และมีเฉพาะข้อมูลที่ล้างทิ้งได้
TEST_DATABASE_URL=
# ตั้ง true หลังยืนยันว่าฐาน test ล้างข้อมูลได้ (ค่าเริ่มต้นปิด)
TEST_DATABASE_RESET_ALLOWED=false
# เปลี่ยนได้เมื่อพอร์ตทดสอบชนกับโปรแกรมอื่น ห้ามใช้พอร์ต dev 5173/8787
TEST_WEB_PORT=5174
TEST_API_PORT=8788
# ไม่ต้องตั้ง APP_ENV เอง npm test และ db:migrate:test จัดการให้อัตโนมัติ

# ที่อยู่ของหน้าเว็บ ใช้ประกอบ redirect URI ของ Google และกันการ redirect ออกนอกเว็บ
APP_ORIGIN=http://127.0.0.1:5173

# พอร์ตของ API ตอน dev (ไม่ใส่ก็ได้ ค่าเริ่มต้นคือ 8787)
PORT=8787

# Google OAuth (ไม่ใส่ก็ได้ ถ้าไม่ใส่ ปุ่มเข้าสู่ระบบด้วย Google จะไม่ขึ้นแทนที่จะขึ้นแล้วพัง)
# สร้างที่ Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# แล้วใส่ Authorized redirect URI เป็น <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ใช้เฉพาะตอนรัน npm run db:admin เพื่อสร้างบัญชีทีมตรวจ ไม่ต้องเก็บไว้ถาวร
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
