{
  "name": "championways",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test-environment.mjs test",
    "test:ui": "node scripts/test-environment.mjs test --ui",
    "test:safety": "node --import tsx --test scripts/database-safety.test.ts",
    "test:auth": "node scripts/test-environment.mjs auth",
    "dev:api": "tsx watch server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/test-environment.mjs seed",
    "db:migrate:test": "node scripts/test-environment.mjs migrate",
    "db:admin": "tsx server/db/create-admin.ts",
    "db:admin:sql": "tsx scripts/admin-sql.ts"
  },
  "dependencies": {
    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-sans-thai": "^5.2.0",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^0.577.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
